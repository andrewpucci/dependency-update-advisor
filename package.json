{
  "name": "dependency-update-advisor",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp pack && node scripts/license-notices.mjs .github/actions/dependabot-review/dist",
    "complexity": "node scripts/complexity/report.mjs",
    "measure:demand": "vp test run --config scripts/measure-demand/vitest.config.mjs",
    "measure:heap": "node scripts/measure-heap/run.ts",
    "probe:batching": "vp test run --config scripts/measure-batching/vitest.config.mjs",
    "probe:comment-limit": "node scripts/probe-comment-limit/run.ts",
    "probe:token-length": "node scripts/probe-token-length/run.ts",
    "test:complexity": "node --test scripts/complexity/report.test.mjs",
    "check": "tsc --project tsconfig.json --noEmit",
    "check:limits": "node scripts/limits/check.ts",
    "test": "vp test",
    "lint": "npm run lint:code && npm run lint:md",
    "lint:code": "vp lint",
    "lint:md": "markdownlint --config .markdownlint.json --dot --ignore \".context/**\" --ignore \"node_modules/**\" \"**/*.md\"",
    "format": "vp fmt",
    "format:check": "vp fmt --check"
  },
  "dependencies": {
    "@renovatebot/pep440": "6.0.0",
    "semver": "7.8.6",
    "smol-toml": "1.9.1",
    "spdx-expression-parse": "5.0.0",
    "stream-json": "3.9.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "@types/spdx-expression-parse": "4.0.0",
    "ajv": "8.20.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "markdownlint-cli": "0.50.1",
    "typescript": "7.0.2",
    "vite-plus": "1.7.0"
  },
  "overrides": {
    "markdownlint-cli": {
      "run-con": "1.3.2"
    }
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
