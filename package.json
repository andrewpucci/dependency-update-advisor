{
  "name": "dependency-update-advisor",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp pack && node scripts/license-notices.mjs .github/actions/dependabot-review/dist",
    "complexity": "node scripts/complexity/report.mjs",
    "test:complexity": "node --test scripts/complexity/report.test.mjs",
    "check": "tsc --project tsconfig.json --noEmit",
    "test": "vp test",
    "lint": "npm run lint:code && npm run lint:md",
    "lint:code": "vp lint",
    "lint:md": "markdownlint --config .markdownlint.json --dot --ignore \".context/**\" --ignore \"node_modules/**\" \"**/*.md\"",
    "format": "vp fmt",
    "format:check": "vp fmt --check"
  },
  "dependencies": {
    "@renovatebot/pep440": "6.0.0",
    "semver": "7.8.6",
    "smol-toml": "1.9.1",
    "spdx-expression-parse": "5.0.0",
    "stream-json": "3.8.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/semver": "7.8.0",
    "@types/spdx-expression-parse": "4.0.0",
    "ajv": "8.20.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "markdownlint-cli": "0.50.0",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "markdownlint-cli": {
      "run-con": "1.3.2"
    }
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
